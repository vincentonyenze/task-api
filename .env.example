# Settings for the Task API.
# Copy this file to .env and change what you need. .env is never committed
# (it's in .gitignore), so it can hold values that differ per computer,
# and later, secrets.

# The port the server listens on (1-65535). Default: 3000
PORT=3000

# development, test or production. Default: development
NODE_ENV=development

# Where tasks are kept: file (survives a restart) or memory. Default: file
STORAGE=file

# The tasks file, used when STORAGE=file. Default: data/tasks.json
DATA_FILE=data/tasks.json

# Web pages (origins) allowed to call the API from a browser, comma-separated,
# or * for any. No path, no trailing slash.
# Default: http://localhost:5173 in development (Vite), none otherwise.
CORS_ORIGINS=http://localhost:5173

# Rate limiting: each client may send RATE_LIMIT_MAX requests every
# RATE_LIMIT_WINDOW_SECONDS. RATE_LIMIT_MAX=0 turns it off.
# Defaults: 100 per 60 seconds.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
